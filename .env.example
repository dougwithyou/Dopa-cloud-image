# =============================================================================
# Hi Dopa Cloud — variables de entorno
# Copia este archivo a .env.local para desarrollo. En Vercel, defínelas en
# Project Settings → Environment Variables. NUNCA subas valores reales a git.
# Solo las variables NEXT_PUBLIC_* llegan al navegador.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Hi Dopa Cloud"
# URL pública sin barra final (en producción: https://tu-dominio)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Días que los portales de clientes siguen abiertos tras impago o cancelación
PORTAL_GRACE_PERIOD_DAYS=14
# Tamaños máximos por archivo (MB)
MAX_PHOTO_UPLOAD_MB=50
MAX_VIDEO_UPLOAD_MB=5120
# Secreto para el cron de limpieza (Vercel lo envía como Bearer). Genera uno: openssl rand -hex 32
CRON_SECRET=
# Firma el acceso de los visitantes de galerías compartidas por enlace. Genera uno: openssl rand -base64 32
SHARE_SECRET=

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo servidor. Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (solo servidor) ------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hidopa-cloud-media

# --- Stripe ------------------------------------------------------------------
# Usa claves de TEST (sk_test_...). Una clave live se rechaza salvo STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_ALLOW_LIVE=false
# Las imprime `npm run stripe:setup`. Si faltan, se resuelven por lookup_key.
STRIPE_PRICE_ENTRY=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_HIGH=
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Resend (correo transaccional) ------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Hi Dopa Cloud <hola@cloud.hidopastudio.com>"
